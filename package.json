{
  "name": "test",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "rm -rf .svelte-kit/output .svelte-kit/cloudflare && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy .svelte-kit/cloudflare --project-name vmabeta",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "playwright test",
    "test:write": "playwright test -c playwright.write.config.ts",
    "db:test": "supabase start -x vector -x logflare && node --env-file=.env.test scripts/seed-test-db.mjs",
    "db:test:reset": "supabase db reset && node --env-file=.env.test scripts/seed-test-db.mjs",
    "lint": "prettier --check . && eslint . && node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "lint:tokens": "node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.43.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.39.5",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@allmaps/annotation": "^1.0.0-beta.35",
    "@allmaps/id": "^1.0.0-beta.38",
    "@allmaps/openlayers": "^1.0.0-beta.81",
    "@allmaps/transform": "^1.0.0-beta.52",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.95.3",
    "driver.js": "^1.8.0",
    "ol": "^10.6.1",
    "ol-pmtiles": "^2.0.2"
  }
}
