PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Internet Archive S3 credentials for map migrations
IA_S3_ACCESS_KEY="YOUR_IA_S3_ACCESS_KEY"
IA_S3_SECRET_KEY="YOUR_IA_S3_SECRET_KEY"

# Supabase service key for admin operations (bypasses RLS)
SUPABASE_SERVICE_KEY="YOUR_SUPABASE_SERVICE_KEY"

# Protomaps hosted basemap API key — https://protomaps.com/dashboard

# Pipeline worker (work/worker/vma_worker.py) — needed on the machine that RUNS
# jobs, not on the web app. Mint a key with:
#   node --env-file=.env scripts/mint-worker-key.mjs <machine-name>
VMA_API_URL="https://maparchive.vn"
VMA_WORKER_KEY="YOUR_WORKER_TOKEN"

# Optional opt-in GA4 measurement. Leave unset until the property is configured.
# Disable Enhanced Measurement/history collection in the GA4 web stream first.
PUBLIC_GA_MEASUREMENT_ID=""
