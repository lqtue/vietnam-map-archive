# Claude Code local session state
.claude/
worker/.wrangler

# PMTiles basemap extracts are built by scripts/pmtiles_extract.sh and live in R2, never in git
*.pmtiles
work/archive/cleanup/

# Scout runs are local discovery artifacts — load them into scout_candidates, do not commit
scripts/scout_all_*.json
scripts/scout_review.csv
work/l7014/
work/research/press/
work/research/legend/
work/research/reports/

# Bulk-upload run logs — one per run, megabytes of per-sheet output.
# The record that matters is the maps rows the run created, not the transcript.
scripts/bulk_upload_*.log

# CartoMundi holdings dumps — 40 MB of upstream catalogue, re-fetched on demand
# by scripts/oneoff/check_indochine_provenance.py. The reduced index beside them
# (sources/nakala.json) is small and IS tracked.
work/tonkin/sources/ign-serie-*.json

# Worker and pipeline run logs — one per run, and a long-running batch keeps
# appending to its file. Same rule as the bulk-upload logs above: the record is
# the rows the run wrote to the database, not the transcript of it writing them.
work/ocr/logs/
work/tonkin/*.log

# outreach ledger + personal application material — never publish
docs/private/

# Vectorize previews are local render artifacts, same as work/ocr/outputs
work/vectorize/

# One-off pipeline run dumps from the 2026-05 deck/KG work
work/archive/deck-and-kg-2026-05/script-outputs/

# indochine100k_georef.py's local placement cache and IIIF tile fetch cache —
# regenerated by place()/detect() from the live source, not a committed artifact
# (the fetch cache alone runs into tens of GB)
work/indochine-100k/*.json
work/indochine-100k/.fetch_cache/

# outreach ledger + personal application material — never publish

# LaTeX build log — the PDF and .tex are the artifacts, the log is not
docs/paper/*.log

# indochine100k working data: raw IGN dumps (141 MB), fetched strips/corners, Gemini cache, run logs
work/indochine-100k/sources/ign-serie-*.json
work/indochine-100k/strips/
work/indochine-100k/corners/
work/indochine-100k/gemini_cache/
work/indochine-100k/full-place*.log
work/indochine-100k/sample-*.jpg
work/indochine-100k/__pycache__/

