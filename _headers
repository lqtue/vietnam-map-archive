# Cloudflare Pages response headers. No CSP shipped before this, and no
# X-Frame-Options, so /catalog (which renders MapEditModal for staff) and
# /admin could both be framed by any origin.
#
# This file belongs in the project root, not static/ — adapter-cloudflare
# fails the build if it finds one under static/, because it writes its own
# into the output directory and will not silently merge two sources.
#
# `frame-ancestors 'none'` is the modern X-Frame-Options; both are sent
# because Safari still honours only the older header.
#
# HTML pages receive SvelteKit's nonce-bearing CSP; this fixed policy applies
# to static responses only, where no inline bootstrap runs.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self'; worker-src 'self' blob:; child-src blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Cloudflare Pages serves everything under static/ with `max-age=0,
# must-revalidate` by default, so on a repeat visit the browser spends a
# round trip per file asking whether it changed. It never has.
#
# The twelve woff2 files are content-stable: a regenerated subset gets a new
# name (see the fonts note in CLAUDE.md), so a year is safe.
/fonts/*
  Cache-Control: public, immutable, max-age=31536000

# Images keep their filenames across a regeneration — `gen-hero-still.mjs`
# overwrites hero-*.webp in place — so they get a day of silence and a week of
# serving the old copy while the new one arrives, not a year of being stuck.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
